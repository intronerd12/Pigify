# ==============================================================================
# Pigify Backend Environment Configuration
# Copy this file to .env and adjust variables to match your environment
# ==============================================================================

PORT=5000
NODE_ENV=development

# Postgres Database (Supabase Database Connection String)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.nmlffxrpdickyvlzrtyr.supabase.co:5432/postgres

# Supabase (Server & Admin Auth)
SUPABASE_URL=https://nmlffxrpdickyvlzrtyr.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xs1GntpWlwPMEoCeA8ASpg_1A6rmGvH
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Cloudinary (Media & Image Uploads)
CLOUDINARY_CLOUD_NAME=dkqnaqbvg
CLOUDINARY_API_KEY=677317515911799
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_URL=cloudinary://677317515911799:your_cloudinary_api_secret_here@dkqnaqbvg

# Google Gemini AI (Veterinary Diagnostic Chatbot & Advisory)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Legacy JWT & Session (used for local token fallback)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_TIME=70d
COOKIE_EXPIRES_TIME=7

# Email Notification / SMTP (Mailtrap or standard SMTP for email verification)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM_EMAIL=noreply@pigify.com
SMTP_FROM_NAME=Pigify Swine Telemetry
