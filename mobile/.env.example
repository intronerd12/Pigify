# ==============================================================================
# Pigify Mobile Environment Configuration Example
# Copy this file to .env and adjust variables to match your environment
# ==============================================================================

# Primary Backend API Base URL
# Leave blank to enable smart auto-detection (Metro LAN IP on physical phones, 10.0.2.2 on Android Emulator, localhost on iOS/Web)
# Or set explicitly (e.g., http://192.168.8.153:5000, http://10.0.2.2:5000, https://dragon-backend.onrender.com)
EXPO_PUBLIC_API_URL=

# Cloud / Render Production Backend URL
EXPO_PUBLIC_RENDER_URL=https://dragon-backend.onrender.com

# Ngrok Public Tunnel URL (auto-synced when running npm run update-ngrok-url)
EXPO_PUBLIC_NGROK_URL=

# Supabase Project Credentials (matches backend/.env and web frontend)
EXPO_PUBLIC_SUPABASE_URL=https://nmlffxrpdickyvlzrtyr.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xs1GntpWlwPMEoCeA8ASpg_1A6rmGvH
