# ==============================================================================
# Pigify Mobile Environment Configuration (Expo SDK 58 / React Native)
# Copy this file to .env and adjust variables to match your environment
# Variables prefixed with EXPO_PUBLIC_ are automatically available at runtime
# ==============================================================================

# Primary Backend API Base URL
# Leave blank to enable smart auto-detection (Metro LAN IP on physical phones, 10.0.2.2 on Android Emulator, localhost on iOS/Web)
# Or set explicitly (e.g., http://192.168.8.162:5000, http://10.0.2.2:5000, https://pigify-backend.onrender.com)
EXPO_PUBLIC_API_URL=

# Cloud / Render Production Backend URL
EXPO_PUBLIC_RENDER_URL=https://pigify-backend.onrender.com

# Ngrok Public Tunnel URL (auto-synced when running npm run update-ngrok-url)
EXPO_PUBLIC_NGROK_URL=

# Supabase Project Credentials (matches backend and web frontend)
EXPO_PUBLIC_SUPABASE_URL=https://nmlffxrpdickyvlzrtyr.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xs1GntpWlwPMEoCeA8ASpg_1A6rmGvH

# Cloudinary Storage Credentials (direct HTTPS mobile upload)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=dkqnaqbvg
EXPO_PUBLIC_CLOUDINARY_API_KEY=677317515911799
EXPO_PUBLIC_CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
EXPO_PUBLIC_CLOUDINARY_URL=cloudinary://677317515911799:your_cloudinary_api_secret_here@dkqnaqbvg

# Google Gemini AI (Mobile In-App Veterinary Chatbot)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
